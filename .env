# Database Configuration
DB_HOST=dpg-d7k8hrl7vvec73969alg-a.virginia-postgres.render.com
DB_PORT=5432
DB_NAME=moodchat
DB_USER=moodchat_user
DB_PASSWORD=5CzyEV3lQZNgKruwJHOzA7bw8q6T72xD
DATABASE_URL=postgresql://moodchat_user:5CzyEV3lQZNgKruwJHOzA7bw8q6T72xD@dpg-d7k8hrl7vvec73969alg-a.virginia-postgres.render.com/moodchat?sslmode=verify-full

# Server Configuration
NODE_ENV=development
PORT=3000
HOST=localhost

# JWT Configuration
JWT_SECRET=moodchat_jwt_secret_key_2024_secure_token_for_authentication
JWT_ACCESS_SECRET=moodchat_jwt_access_secret_key_2024_secure_access_token
JWT_REFRESH_SECRET=moodchat_jwt_refresh_secret_key_2024_secure_refresh_token
JWT_EXPIRE=24h
JWT_REFRESH_EXPIRE=7d

# Redis Configuration (optional, if using Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS Configuration
FRONTEND_URL=https://moodfronted.onrender.com
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://moodfronted.onrender.com

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx

# Email Configuration (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Session Configuration
SESSION_SECRET=moodchat_session_secret_key_2024_secure_session
SESSION_MAX_AGE=86400000

# Feature Flags
FEATURE_WEBSOCKETS=true
FEATURE_UPLOADS=true
FEATURE_EMAIL=true
FEATURE_RATE_LIMITING=true

# Production Configuration
RENDER=false
RENDER_SERVICE_ID=
RENDER_EXTERNAL_URL=
BACKEND_URL=http://localhost:3000

# Database Pool Configuration
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_POOL_ACQUIRE=60000
DB_POOL_IDLE=30000

# Security Configuration
BCRYPT_ROUNDS=12
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTP_ONLY=true
SESSION_COOKIE_SAME_SITE=lax

# Development Configuration
DB_CONNECT_ON_LOAD=false
DB_LOGGING=false
UV_THREADPOOL_SIZE=16

# CORS Additional Settings
CORS_CREDENTIALS=true
CORS_OPTIONS_SUCCESS_STATUS=204

# Compression Configuration
COMPRESSION_ENABLED=true
COMPRESSION_LEVEL=6
COMPRESSION_THRESHOLD=1024

# Query Timeout Configuration
QUERY_TIMEOUT_MS=8000

# Cache Configuration
LOGIN_CACHE_TTL=30000
REQUEST_CACHE_TTL=5000

# WebSocket Configuration
WEBSOCKET_PATH=/ws
WEBSOCKET_HEARTBEAT_INTERVAL=30000

# File Upload Additional Settings
UPLOAD_MAX_FILES=5
UPLOAD_TEMP_DIR=temp
UPLOAD_CLEANUP_INTERVAL=3600000

# Email Additional Settings
EMAIL_FROM=noreply@moodchat.com
EMAIL_REPLY_TO=support@moodchat.com

# API Configuration
API_VERSION=v1
API_PREFIX=/api
API_RATE_LIMIT_WINDOW=900000
API_RATE_LIMIT_MAX=100

# Monitoring Configuration
HEALTH_CHECK_ENDPOINT=/health
METRICS_ENDPOINT=/metrics
STATUS_ENDPOINT=/status
