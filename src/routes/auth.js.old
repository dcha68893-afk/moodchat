// src/routes/auth.js - FIXED VALIDATE TOKEN
require('dotenv').config();
const express = require('express');
const jwt = require('jsonwebtoken');
const bcrypt = require('bcryptjs');
const asyncHandler = require('express-async-handler');

const router = express.Router();

// DEBUG ENDPOINT - Show JWT_SECRET info
router.get('/debug', (req, res) => {
    console.log('🔍 DEBUG endpoint called');
    res.json({
        success: true,
        jwtSecretLength: JWT_SECRET ? JWT_SECRET.length : 0,
        jwtSecretFirst10: JWT_SECRET ? JWT_SECRET.substring(0, 10) : 'NOT SET',
        envJwtSecretSet: !!process.env.JWT_SECRET,
        envJwtAccessSecretSet: !!process.env.JWT_ACCESS_SECRET,
        nodeEnv: process.env.NODE_ENV
    });
});

const db = require('../models');
const Users = db.User || db.Users;

const JWT_SECRET = process.env.JWT_SECRET || process.env.JWT_ACCESS_SECRET;

console.log('✅ AUTH ROUTER LOADED - FIXED VERSION');

// LOGIN ENDPOINT
router.post('/login', asyncHandler(async (req, res) => {
  console.log('🔐 LOGIN called');
  const { identifier, password } = req.body;
  
  const user = await Users.findOne({
    where: {
      [require('sequelize').Op.or]: [
        { email: identifier },
        { username: identifier }
      ]
    }
  });
  
  if (!user) {
    return res.status(401).json({ success: false, message: 'Invalid credentials' });
  }
  
  const valid = await bcrypt.compare(password, user.password);
  if (!valid) {
    return res.status(401).json({ success: false, message: 'Invalid credentials' });
  }
  
  const token = jwt.sign(
    { 
      userId: user.id, 
      id: user.id, 
      email: user.email,
      username: user.username,
      role: user.role || 'user'
    }, 
    JWT_SECRET, 
    { expiresIn: '24h' }
  );
  
  res.json({
    success: true,
    token: token,
    user: { id: user.id, username: user.username, email: user.email }
  });
}));

// VALIDATE TOKEN ENDPOINT - FIXED VERSION
router.post('/validate-token', async (req, res) => {
  console.log('🔍 VALIDATE TOKEN ENDPOINT CALLED');
  
  // Extract token from multiple sources
  let token = null;
  
  // Check Authorization header
  const authHeader = req.headers.authorization;
  if (authHeader && authHeader.startsWith('Bearer ')) {
    token = authHeader.substring(7);
    console.log('✅ Token extracted from Authorization header');
  }
  
  // Check body
  if (!token && req.body.token) {
    token = req.body.token;
    console.log('✅ Token extracted from request body');
  }
  
  if (!token) {
    console.log('❌ No token provided');
    return res.status(400).json({
      success: false,
      valid: false,
      message: 'Token required',
      code: 'MISSING_TOKEN'
    });
  }
  
  try {
    console.log('Verifying token...');
    const decoded = jwt.verify(token, JWT_SECRET);
    console.log('✅ Token verified for user:', decoded.userId);
    
    res.json({
      success: true,
      valid: true,
      authValidated: true,
      message: 'Token is valid',
      user: {
        id: decoded.userId,
        userId: decoded.userId,
        email: decoded.email,
        username: decoded.username,
        role: decoded.role || 'user'
      },
      userId: decoded.userId
    });
  } catch (error) {
    console.error('❌ Token validation error:', error.message);
    res.status(401).json({
      success: false,
      valid: false,
      message: error.message,
      code: error.name === 'TokenExpiredError' ? 'TOKEN_EXPIRED' : 'INVALID_TOKEN'
    });
  }
});


// DEBUG VALIDATE TOKEN - Shows what's happening
router.post('/validate-token-debug', async (req, res) => {
    console.log('🔍 DEBUG VALIDATE TOKEN CALLED');
    console.log('Headers:', JSON.stringify(req.headers, null, 2));
    console.log('Body:', JSON.stringify(req.body, null, 2));
    console.log('JWT_SECRET (first 10):', JWT_SECRET ? JWT_SECRET.substring(0, 10) : 'NOT SET');
    
    let token = null;
    
    // Check Authorization header
    const authHeader = req.headers.authorization;
    if (authHeader) {
        console.log('Auth header:', authHeader);
        if (authHeader.startsWith('Bearer ')) {
            token = authHeader.substring(7);
            console.log('Token from header:', token.substring(0, 50) + '...');
        }
    }
    
    // Check body
    if (!token && req.body.token) {
        token = req.body.token;
        console.log('Token from body:', token.substring(0, 50) + '...');
    }
    
    if (!token) {
        console.log('No token found');
        return res.json({
            success: false,
            valid: false,
            message: 'No token found',
            debug: {
                hasAuthHeader: !!authHeader,
                hasBodyToken: !!req.body.token,
                bodyKeys: Object.keys(req.body)
            }
        });
    }
    
    try {
        console.log('Verifying token...');
        const decoded = jwt.verify(token, JWT_SECRET);
        console.log('✅ Token verified for user:', decoded.userId);
        
        res.json({
            success: true,
            valid: true,
            authValidated: true,
            message: 'Token is valid',
            user: {
                id: decoded.userId,
                userId: decoded.userId,
                email: decoded.email,
                username: decoded.username,
                role: decoded.role || 'user'
            },
            userId: decoded.userId,
            debug: {
                decoded: decoded
            }
        });
    } catch (error) {
        console.error('❌ Token validation error:', error.message);
        console.error('Error stack:', error.stack);
        res.status(401).json({
            success: false,
            valid: false,
            message: error.message,
            code: error.name === 'TokenExpiredError' ? 'TOKEN_EXPIRED' : 'INVALID_TOKEN',
            debug: {
                errorName: error.name,
                errorMessage: error.message,
                jwtSecretLength: JWT_SECRET ? JWT_SECRET.length : 0
            }
        });
    }
});

module.exports = router;


