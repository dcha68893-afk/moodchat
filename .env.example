# Database Configuration
DB_HOST=YOUR_DB_HOST
DB_PORT=5432
DB_NAME=YOUR_DB_NAME
DB_USER=YOUR_DB_USER
DB_PASSWORD=YOUR_DB_PASSWORD_HERE
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD_HERE@YOUR_DB_HOST/YOUR_DB_NAME?sslmode=verify-full

# Server Configuration
NODE_ENV=development
PORT=4000
HOST=localhost

# JWT Configuration
JWT_SECRET=CHANGE_ME_STRONG_JWT_SECRET_MIN_64_CHARS
JWT_ACCESS_SECRET=CHANGE_ME_STRONG_JWT_ACCESS_SECRET_MIN_64_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_STRONG_JWT_REFRESH_SECRET_MIN_64_CHARS
JWT_EXPIRE=24h
JWT_REFRESH_EXPIRE=7d

# Redis Configuration (optional, if using Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS / Frontend Configuration
# Production frontend is configured here; never hardcode it in application source.
FRONTEND_URL=https://necpra.co.ke
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://necpra.co.ke
CORS_ADDITIONAL_ORIGINS=
CORS_CREDENTIALS=true
CORS_OPTIONS_SUCCESS_STATUS=204

# Google OAuth (Sign in with Google)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# Production Configuration
RENDER=false
RENDER_SERVICE_ID=
RENDER_EXTERNAL_URL=
BACKEND_URL=http://localhost:4000

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
MAX_UPLOAD_SIZE=52428800
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx

# Persistent media storage (recommended for production)
# Use EITHER CLOUDINARY_URL or all three CLOUDINARY_* values.
CLOUDINARY_URL=cloudinary://YOUR_CLOUDINARY_API_KEY:YOUR_CLOUDINARY_API_SECRET@YOUR_CLOUDINARY_CLOUD_NAME

# Email Configuration (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=Necpra <noreply@necpra.co.ke>
EMAIL_REPLY_TO=support@necpra.co.ke

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Session Configuration
SESSION_SECRET=CHANGE_ME_STRONG_SESSION_SECRET
SESSION_MAX_AGE=86400000

# Feature Flags
FEATURE_WEBSOCKETS=true
FEATURE_UPLOADS=true
FEATURE_EMAIL=true
FEATURE_RATE_LIMITING=true

# Database Pool Configuration
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_POOL_ACQUIRE=60000
DB_POOL_IDLE=30000

# Security Configuration
BCRYPT_ROUNDS=12
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTP_ONLY=true
SESSION_COOKIE_SAME_SITE=lax

# Development Configuration
DB_CONNECT_ON_LOAD=false
DB_LOGGING=false
UV_THREADPOOL_SIZE=16
ALLOW_PRODUCTION_IN_DEV=false

# Compression Configuration
COMPRESSION_ENABLED=true
COMPRESSION_LEVEL=6
COMPRESSION_THRESHOLD=1024

# Query Timeout Configuration
QUERY_TIMEOUT_MS=8000

# Cache Configuration
LOGIN_CACHE_TTL=30000
REQUEST_CACHE_TTL=5000

# WebSocket Configuration
WEBSOCKET_PATH=/ws
WEBSOCKET_HEARTBEAT_INTERVAL=30000

# File Upload Additional Settings
UPLOAD_MAX_FILES=5
UPLOAD_TEMP_DIR=temp
UPLOAD_CLEANUP_INTERVAL=3600000

# API Configuration
API_VERSION=v1
API_PREFIX=/api
API_RATE_LIMIT_WINDOW=900000
API_RATE_LIMIT_MAX=100

# Monitoring Configuration
HEALTH_CHECK_ENDPOINT=/health
METRICS_ENDPOINT=/metrics
STATUS_ENDPOINT=/status

# Phase 1 + Phase 5 diagnostics
INTERNAL_DIAG_TOKEN=CHANGE_ME_INTERNAL_DIAG_TOKEN

# Optional Phase 3 WebRTC TURN server
TURN_HOST=YOUR_TURN_HOST
TURN_PORT=3478
TURN_SECRET=YOUR_TURN_SECRET