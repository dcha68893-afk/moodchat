# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DB_HOST=your-db-host
DB_PORT=5432
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# ─── JWT Secrets (generate with: openssl rand -base64 64) ─────────────────────
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING
JWT_ACCESS_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_RANDOM_STRING
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_64_CHAR_RANDOM_STRING
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
BACKEND_URL=https://your-backend.render.com
FRONTEND_URL=https://your-frontend.web.app

# ─── M-Pesa (Safaricom Daraja) ────────────────────────────────────────────────
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=your_shortcode
MPESA_PASSKEY=your_passkey
MPESA_ENV=sandbox

# ─── Card Payments (Flutterwave) ──────────────────────────────────────────────
FLW_SECRET_KEY=FLWSECK_TEST-xxxx
FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxx

# ─── Firebase (Push Notifications) ────────────────────────────────────────────
FIREBASE_SERVER_KEY=your_fcm_server_key

# ─── Email (Nodemailer) ───────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your@gmail.com
EMAIL_PASS=your_app_password

# ─── Marketplace Config ───────────────────────────────────────────────────────
SELLER_COMMISSION=0.05
