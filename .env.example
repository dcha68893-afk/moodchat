# Database Configuration
DB_HOST=YOUR_DB_HOST
DB_PORT=5432
DB_NAME=YOUR_DB_NAME
DB_USER=YOUR_DB_USER
DB_PASSWORD=YOUR_DB_PASSWORD_HERE
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD_HERE@YOUR_DB_HOST/YOUR_DB_NAME?sslmode=verify-full

# Server Configuration
NODE_ENV=development
PORT=4000
HOST=localhost

# JWT Configuration
JWT_SECRET=CHANGE_ME_STRONG_JWT_SECRET_MIN_64_CHARS
JWT_ACCESS_SECRET=CHANGE_ME_STRONG_JWT_ACCESS_SECRET_MIN_64_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_STRONG_JWT_REFRESH_SECRET_MIN_64_CHARS
JWT_EXPIRE=24h
JWT_REFRESH_EXPIRE=7d

# Redis Configuration (optional, if using Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS Configuration
FRONTEND_URL=https://nexopa.onrender.com
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://nexopa.onrender.com

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx

# Email Configuration (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Google OAuth (Sign in with Google)
# Client ID from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
# Not required for ID-token verification, but kept for reference/future use
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# Session Configuration
SESSION_SECRET=CHANGE_ME_STRONG_SESSION_SECRET
SESSION_MAX_AGE=86400000

# Feature Flags
FEATURE_WEBSOCKETS=true
FEATURE_UPLOADS=true
FEATURE_EMAIL=true
FEATURE_RATE_LIMITING=true

# Production Configuration
RENDER=false
RENDER_SERVICE_ID=
RENDER_EXTERNAL_URL=
BACKEND_URL=http://localhost:4000

# Database Pool Configuration
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_POOL_ACQUIRE=60000
DB_POOL_IDLE=30000

# Security Configuration
BCRYPT_ROUNDS=12
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTP_ONLY=true
SESSION_COOKIE_SAME_SITE=lax

# Development Configuration
DB_CONNECT_ON_LOAD=false
DB_LOGGING=false
UV_THREADPOOL_SIZE=16

# CORS Additional Settings
CORS_CREDENTIALS=true
CORS_OPTIONS_SUCCESS_STATUS=204

# Compression Configuration
COMPRESSION_ENABLED=true
COMPRESSION_LEVEL=6
COMPRESSION_THRESHOLD=1024

# Query Timeout Configuration
QUERY_TIMEOUT_MS=8000

# Cache Configuration
LOGIN_CACHE_TTL=30000
REQUEST_CACHE_TTL=5000

# WebSocket Configuration
WEBSOCKET_PATH=/ws
WEBSOCKET_HEARTBEAT_INTERVAL=30000

# File Upload Additional Settings
UPLOAD_MAX_FILES=5
UPLOAD_TEMP_DIR=temp
UPLOAD_CLEANUP_INTERVAL=3600000

# Email Additional Settings
EMAIL_FROM=noreply@nexopa.com
EMAIL_REPLY_TO=support@nexopa.com

# API Configuration
API_VERSION=v1
API_PREFIX=/api
API_RATE_LIMIT_WINDOW=900000
API_RATE_LIMIT_MAX=100

# Monitoring Configuration
HEALTH_CHECK_ENDPOINT=/health
METRICS_ENDPOINT=/metrics
STATUS_ENDPOINT=/status

# ═══ PHASE 1–5 BOOTSTRAP ════════════════════════════════════════════════════

# Required for Phase 1 + Phase 5 diagnostics endpoint (/internal/diagnostics)
INTERNAL_DIAG_TOKEN=CHANGE_ME_INTERNAL_DIAG_TOKEN

# Optional — Phase 3 WebRTC TURN server (leave blank to use STUN-only fallback)
TURN_HOST=YOUR_TURN_HOST
TURN_PORT=3478
TURN_SECRET=YOUR_TURN_SECRET
# ── Email (SMTP) ───────────────────────────────────────────────────────────────
# Set these in Render's Environment Variables panel for real email sending.
# Works with Gmail, SendGrid, Mailgun, Brevo, etc.
# Gmail: SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=you@gmail.com  SMTP_PASS=your-app-password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Nexopa <noreply@nexopa.com>
