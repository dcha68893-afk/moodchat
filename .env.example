# ─── Database ───────────────────────────────────────────────────────────────
DB_HOST=your-db-host
DB_PORT=5432
DB_NAME=moodchat_db
DB_USER=moodchat_user
DB_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full

# ─── Server ─────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
BACKEND_URL=https://your-render-service.onrender.com

# ─── JWT (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))") ──
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_HEX
JWT_ACCESS_SECRET=CHANGE_ME_64_CHAR_RANDOM_HEX
JWT_REFRESH_SECRET=CHANGE_ME_64_CHAR_RANDOM_HEX
JWT_EXPIRE=24h
JWT_REFRESH_EXPIRE=7d

# ─── CORS ───────────────────────────────────────────────────────────────────
FRONTEND_URL=https://moodfronted.onrender.com
ALLOWED_ORIGINS=https://moodfronted.onrender.com

# ─── Redis (optional, falls back to in-memory) ──────────────────────────────
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Email ──────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@moodchat.com

# ─── M-Pesa (Daraja) ────────────────────────────────────────────────────────
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_ENV=sandbox

# ─── Internal ───────────────────────────────────────────────────────────────
INTERNAL_DIAG_TOKEN=CHANGE_ME
TURN_HOST=
TURN_PORT=3478
TURN_SECRET=

# ─── Feature Flags ──────────────────────────────────────────────────────────
FEATURE_WEBSOCKETS=true
FEATURE_UPLOADS=true
FEATURE_EMAIL=true
FEATURE_RATE_LIMITING=true

# ─── DB Pool ────────────────────────────────────────────────────────────────
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_POOL_ACQUIRE=60000
DB_POOL_IDLE=30000
UV_THREADPOOL_SIZE=16
